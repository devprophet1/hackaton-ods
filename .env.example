PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Proveedor de IA: openrouter (predeterminado), openai o gemini.
# Si lo cambias, ejecuta npm run kb:seed: los embeddings no son compatibles entre proveedores.
AI_PROVIDER=openrouter
# Opcionales: esfuerzo de razonamiento (por defecto none) y similitud mínima del RAG
# (por defecto 0.3 con openrouter/openai y 0.5 con gemini).
AI_REASONING_EFFORT=
AI_MIN_SIMILARITY=
# Opcional: URL pública que se envía a OpenRouter como HTTP-Referer.
APP_URL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=openai/gpt-5.4-mini

# OpenAI (alternativa)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini

# Gemini (alternativa)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.6-flash
