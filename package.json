{
  "name": "rimay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rimay: plataforma de prevención de violencia (ODS 5) para el HackODS UA 2026",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "seed:users": "node --env-file-if-exists=.env scripts/seed.js",
    "kb:seed": "node --env-file-if-exists=.env scripts/kb-seed.js",
    "kb:test": "node --env-file-if-exists=.env scripts/kb-test.js",
    "check": "node --env-file-if-exists=.env scripts/check-env.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "express": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "multer": "^2.5.0",
    "openai": "^7.62.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
